# Local Postgres（docker-compose：postgres 服務；host 連線走 localhost 對外 port）
# 用 5433 而非預設 5432：避免跟本機常見的原生 Postgres 安裝衝突。
DATABASE_URL="postgresql://meetbot:meetbot_local_dev@localhost:5433/meetbot"
# Prisma CLI 專用（db push）。本機沒有 pgbouncer，兩者可指向同一條連線字串。
DIRECT_URL="postgresql://meetbot:meetbot_local_dev@localhost:5433/meetbot"

# Local MinIO（S3 相容，取代 Supabase Storage；docker-compose：minio 服務）
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="meetbot"
S3_SECRET_KEY="meetbot_local_dev"
S3_BUCKET="meeting-materials"
S3_REGION="us-east-1"

# Dify
DIFY_API_BASE="https://api.dify.ai/v1"
DIFY_DATASET_API_KEY="dataset-..."
DIFY_WORKFLOW_API_KEY="app-..."
DIFY_SUMMARY_WORKFLOW_API_KEY="app-..."
DIFY_MEETING_SUMMARY_WORKFLOW_API_KEY="app-..."
DIFY_CHATFLOW_TIMEOUT_MS=45000

# Anthropic，唯一的應用場景：無關聯專案的會議
ANTHROPIC_API_KEY="sk-ant-..."

# ── Recall.ai（唯一 bot provider）──────────────────────────────────────────
# Region 例：ap-northeast-1（Tokyo）。
RECALL_API_URL="https://ap-northeast-1.recall.ai"
RECALL_API_KEY="..."
# 等待 bot 真正進會議的逾時（毫秒）。Recall 進場較慢，給 90s。
RECALL_ADMISSION_TIMEOUT_MS=90000
# recallai_streaming 轉錄語言；'auto' 可中英夾雜（中文會議建議）。
RECALL_TRANSCRIBE_LANGUAGE=auto

# ── Recall 即時 webhook（語音/聊天即時問答用，optional）─────────────────────────
# Recall 會「主動 POST」即時逐字稿/聊天到這個公開網址，再轉進本機 backend。
# localhost 外網進不來，故本機開發需要一條 tunnel（見 README 的 ngrok 步驟）。
# 未設則 Recall 退回 meeting_captions：只有會後逐字稿、無即時喚醒詞問答。
RECALL_WEBHOOK_URL="https://YOUR-FIXED-DOMAIN.ngrok-free.dev"
# 自訂一組隨機字串當共享密鑰（驗證 Recall 來源）。
RECALL_WEBHOOK_TOKEN="change-me-to-a-random-string"

# Recall bot 講話的 TTS（text→mp3）。未設則 Recall bot 無法語音回答（聊天文字回答仍可）。
OPENAI_API_KEY="sk-..."

# ── Output Media 即時語音 agent（方案 A，docs/16）──────────────────────────────
# on：Recall bot 加掛 agent 網頁（耳朵/嘴巴走串流，喚醒 ack 由分鐘級降到秒級）。
# off（預設）：完全走現行 webhook + mp3 路徑，行為與舊版一致。
# 真正啟用需同時設定：AGENT_PAGE_URL、OPENAI_API_KEY、RECALL_WEBHOOK_URL、RECALL_WEBHOOK_TOKEN。
AGENT_MODE=off
# agent 網頁的公開 URL（後端 /agent，與 /ws/agent 同源）。
# 用 start.ps1 啟動時會自動開 cloudflared quick tunnel 並改寫這一行（網址每次啟動會變）；
# 需先安裝：winget install Cloudflare.cloudflared。
# 不能用 ngrok 免費域名：瀏覽器導覽會被 ERR_NGROK_6024 警告頁擋住，bot 開不進網頁。
AGENT_PAGE_URL="https://replaced-by-start-ps1.trycloudflare.com/agent"

# ── 獨立音軌 / 逐軌轉錄 ────────────────────────────────────────────────────────
# RECALL_SEPARATE_AUDIO=on：Recall 把「每位與會者各自一條」的 PCM 推到 /ws/recall-audio。
# off（預設）：join payload 完全不變。
RECALL_SEPARATE_AUDIO=off
# 轉錄來源：
#   mixed（預設）  = Output Media 網頁的單軌混音。講者只能靠 speaker-timeline 回看窗猜，
#                    多人會議常猜錯；她說話時 AEC 雙講失真會把「蜜塔」聽成「立大」。
#   per-track      = 每位與會者一條音軌各自轉錄。講者是 Recall 直接給的，不用猜；
#                    音軌不經瀏覽器所以沒有 AEC 失真。
#                    ⚠️ 成本約為與會人數倍（每人一條 OpenAI 轉錄連線）。
# per-track 需要 RECALL_SEPARATE_AUDIO=on ＋ agent 模式齊全，任一不足會自動退回 mixed。
TRANSCRIBE_MODE=mixed

# ── 打斷策略（她講話時什麼情況該讓路）────────────────────────────────────────
#   stop-only（預設）= 只有明確叫停（「蜜塔閉嘴」「安靜」…）能打斷她。
#                      旁人交談、附和、提問者的尾音一律不讓路。demo 用這個：
#                      寧可她把話講完，也不要被雜訊切掉半句。
#   adaptive        = 完整策略：講者閘門（提問者／旁人不同字數門檻）、開口寬限期、
#                      延後定案（先暫停看對方有沒有繼續講，沒有就自己接回去）。
#                      她會試著判斷「這是真的打斷還是附和」，判錯就會被切掉半句。
# 兩個模式的叫停路徑完全相同——叫停一律繞過所有閘門，立即停聲。
BARGE_IN_MODE=stop-only

# Server
APP_PORT=4000
APP_CORS_ORIGINS="http://localhost:3000"
# 前端基底 URL，用於組出邀請接受連結（寄到信裡的 /invitations/accept?token=...）
APP_BASE_URL="http://localhost:3000"

# 寄信（專案邀請信）— 全部 optional
# 未設定時：邀請仍會建立，接受連結會印在 backend log，邀請對話框也會顯示可複製的連結，
#           只是不會真的寄出 email。要真的寄信才需要填以下設定。
#
# 用 Gmail 寄信的步驟：
#   1. 用「你自己的」Gmail（不是別人的），先到帳號設定開啟「兩步驟驗證」。
#   2. 到 https://myaccount.google.com/apppasswords 產生 16 碼「應用程式密碼」。
#   3. SMTP_PASS 填那 16 碼（把空格全部拿掉，連成一串，不要加引號）。
#   4. SMTP_USER / MAIL_FROM 填你自己的 Gmail。寄件人會顯示成這個帳號；收件人不限。
#   5. 改完 .env 後要「重啟 backend」才會生效（dev 沒有 watch）。
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-own@gmail.com"
SMTP_PASS="your16charapppassword"
MAIL_FROM="your-own@gmail.com"
# 邀請連結有效天數
INVITATION_TTL_DAYS=7
# ── 主動插話（interjection）────────────────────────────────────────────────────
# 蜜塔沒被叫名字時也會判斷是否主動用聊天室補充（預設關閉）
INTERJECTION_ENABLED=false
# 停頓多久視為一輪話結束（ms）
INTERJECTION_TURN_SILENCE_MS=2500
# 兩次主動插話的最小間隔（ms）
INTERJECTION_COOLDOWN_MS=90000
# 時機層：silence=純停頓計時；livekit=LiveKit turn-detector 模型（首次啟用下載 ~150MB）
INTERJECTION_TURN_DETECTOR=silence
# livekit 模式：靜默多久先問 EOU 模型（ms）
INTERJECTION_EOU_CHECK_MS=1000
# EOU 閾值查表語言碼 / 閾值覆蓋（實測講完 ≥0.68、沒講完 ≤0.008；0.1 為保守值）
INTERJECTION_EOU_LANGUAGE=zh
INTERJECTION_EOU_THRESHOLD=0.1

# Gemini（optional）：設定後插話決策/無知識庫問答改走 Gemini 免費額度（aistudio.google.com/apikey）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 插話/破冰專用的第二把 Gemini key（另一個帳號的免費額度）。未設定時退回 GEMINI_API_KEY。
# 插話決策每輪講話都會打 LLM、最燒額度，用獨立帳號隔離，燒完不拖垮其他功能。
GEMINI_INTERJECTION_API_KEY=
# 新帳號不能用 gemini-2.5-flash（對新用戶停開），預設用 lite 系列 alias。
GEMINI_INTERJECTION_MODEL=gemini-flash-lite-latest
# 沉默破冰：全場沉默超過 40 秒蜜塔主動開口（預設關閉）
ICEBREAKER_ENABLED=false
ICEBREAKER_SILENCE_MS=40000
ICEBREAKER_COOLDOWN_MS=300000

# 回覆功能標籤：蜜塔的聊天室訊息前面標【資料檢索】【冷場插話】【破冰】等，
# 讓每則回覆可歸因到觸發它的子系統（除錯與回應品質評估的前提）。
# 語音永遠不唸標籤，不受此開關影響。正式對外會議不想露出除錯資訊時設 off。
REPLY_TAGS=on

# 內部端點密鑰：前端 NextAuth 登入時向後端取得 authToken。
# 前後端（frontend/.env.local 與此檔）需設同值。
INTERNAL_AUTH_SECRET="請自行產生一串隨機字元（≥16字）"
