generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // CLI（db execute / migrate / db pull）走 session pooler(5432)：
  // transaction pooler(6543) 跑 DDL 會被 pgbouncer 斷線（P1017）
  directUrl = env("DIRECT_URL")
  schemas  = ["app"]
}

// ══════════════════════════════════════════════════
// app schema：應用核心業務邏輯
// ══════════════════════════════════════════════════

model User {
  id                Int         @id @default(autoincrement())
  email             String      @unique
  name              String?
  maxConcurrentBots Int         @default(1) @map("max_concurrent_bots")
  createdAt         DateTime    @default(now()) @map("created_at")
  tokens            UserToken[]

  @@map("users")
  @@schema("app")
}

model UserToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("user_tokens")
  @@schema("app")
}

model Project {
  id            String    @id @default(uuid())
  name          String
  ownerUserId   Int       @map("owner_vexa_user_id")
  difyDatasetId String    @map("dify_dataset_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  members          ProjectMember[]
  invitations      ProjectInvitation[]
  materials        Material[]
  editHistory      MaterialEditHistory[]
  activityLogs     ActivityLog[]
  meetingInstances MeetingInstance[]

  @@index([ownerUserId])
  @@index([deletedAt])
  @@map("projects")
  @@schema("app")
}

model ProjectMember {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  userId          Int      @map("vexa_user_id")
  canView         Boolean  @default(true) @map("can_view")
  canEdit         Boolean  @default(false) @map("can_edit")
  canMeeting      Boolean  @default(false) @map("can_meeting")
  invitedByUserId Int      @map("invited_by_vexa_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
  @@schema("app")
}

/// 待處理的專案邀請。可邀請尚未在系統建立帳號的人（以 email 為依據）。
/// 對方登入後，後端以「已驗證的 Google email」比對 PENDING 邀請，於其信箱列出供接受。
/// token 僅存 SHA-256 hash；接受時強制 email 比對，避免連結外洩被冒領。
model ProjectInvitation {
  id              String           @id @default(uuid())
  projectId       String           @map("project_id")
  email           String // 一律正規化為小寫儲存
  tokenHash       String           @unique @map("token_hash") // token 的 SHA-256（不存明碼）
  canView         Boolean          @default(true) @map("can_view")
  canEdit         Boolean          @default(false) @map("can_edit")
  canMeeting      Boolean          @default(false) @map("can_meeting")
  status          InvitationStatus @default(PENDING)
  invitedByUserId Int              @map("invited_by_vexa_user_id")
  acceptedByUserId Int?            @map("accepted_by_vexa_user_id")
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([email, status])
  @@index([projectId, status])
  @@map("project_invitations")
  @@schema("app")
}

model Material {
  id               String         @id @default(uuid())
  projectId        String         @map("project_id")
  filename         String
  displayName      String         @map("display_name")
  sizeBytes        BigInt         @map("size_bytes")
  mimeType         String         @map("mime_type")
  sha256           String
  storagePath      String         @map("storage_path")
  difyDocumentId   String?        @map("dify_document_id")
  difyBatch        String?        @map("dify_batch")
  indexingStatus   IndexingStatus @default(PENDING) @map("indexing_status")
  indexingError    String?        @map("indexing_error")
  /// 內容摘要卡：索引完成後由 LLM 產生（50~120 字主題摘要），供意圖分類器判斷
  /// 問題是否落在知識庫範圍。null = 尚未產卡（poller 會補）；'' = 已嘗試但無內容。
  contentCard      String?        @map("content_card")
  uploadedByUserId Int            @map("uploaded_by_vexa_user_id")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  project     Project               @relation(fields: [projectId], references: [id])
  editHistory MaterialEditHistory[]

  @@unique([projectId, sha256])
  @@index([projectId, uploadedAt(sort: Desc)])
  @@index([indexingStatus])
  @@map("materials")
  @@schema("app")
}

model MaterialEditHistory {
  id               String     @id @default(uuid())
  projectId        String     @map("project_id")
  materialId       String     @map("material_id")
  action           EditAction
  filenameSnapshot String     @map("filename_snapshot")
  performedByUserId Int       @map("performed_by_vexa_user_id")
  performedAt      DateTime   @default(now()) @map("performed_at")

  project  Project  @relation(fields: [projectId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([projectId, performedAt(sort: Desc)])
  @@index([materialId])
  @@map("material_edit_history")
  @@schema("app")
}

/// 通用活動紀錄：素材增刪、成員增減、權限變更、會議建立、專案改名等。
/// 與 MaterialEditHistory 不同，本表不綁定特定 materialId，可記錄任意專案層級事件。
model ActivityLog {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  actorUserId Int            @map("actor_vexa_user_id")
  action      ActivityAction
  targetLabel String         @map("target_label") // 事件對象的快照字串（檔名 / 成員 email / 會議名稱）
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt(sort: Desc)])
  @@map("activity_logs")
  @@schema("app")
}

model MeetingInstance {
  id                    String        @id @default(uuid())
  projectId             String?       @map("project_id")
  nativeMeetingId       String?       @map("vexa_native_meeting_id")
  name                  String
  googleMeetUrl         String        @map("google_meet_url")
  status                MeetingStatus @default(PENDING)
  createdByUserId       Int           @map("created_by_vexa_user_id")
  startedAt             DateTime?     @map("started_at")
  endedAt               DateTime?     @map("ended_at")
  summary               String?
  actionItems           Json?         @map("action_items")
  keyTopics             Json?         @map("key_topics")
  decisions             Json?
  transcriptStoragePath String?       @map("transcript_storage_path")
  /// 排定的開始／結束時間（UTC）。null = 舊資料或「立刻開」的會議，行事曆上不顯示。
  /// startedAt/endedAt 記的是「實際」發生時間，兩者不可混用：行事曆一律看 scheduled*。
  scheduledStartAt      DateTime?     @map("scheduled_start_at")
  scheduledEndAt        DateTime?     @map("scheduled_end_at")
  /// 建立者當下的 IANA 時區（例：Asia/Taipei）。僅供顯示與 GCal 寫回，計算一律用 UTC。
  timezone              String?
  /// 寫回 Google Calendar 後的事件 id，供後續更新／取消時對應同一筆 GCal 事件。
  gcalEventId           String?       @map("gcal_event_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  project   Project?          @relation(fields: [projectId], references: [id])
  attendees MeetingAttendee[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdByUserId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdByUserId, status])
  @@index([projectId, scheduledStartAt])
  @@map("meeting_instances")
  @@schema("app")
}

/// 會議的與會者與其出席回覆（RSVP）。
///
/// 沿用專案既有的「邏輯 FK」策略：userId 不建 FK 約束（比照 ProjectMember.userId）。
/// meetingId 有 FK，因為會議被硬刪時這些回覆必須跟著消失。
model MeetingAttendee {
  id          String     @id @default(uuid())
  meetingId   String     @map("meeting_id")
  userId      Int        @map("vexa_user_id")
  rsvp        RsvpStatus @default(PENDING)
  /// 最後一次回覆的時間；null = 從未回覆（催辦名單看這個）
  respondedAt DateTime?  @map("responded_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  meeting MeetingInstance @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
  @@schema("app")
}

/// 使用者的 Google Calendar 授權。
///
/// 為什麼 refresh token 要存在後端而不是沿用 NextAuth 的 JWT：疊圖同步與會前提醒
/// 都是背景工作，使用者不在線上時也要能呼叫 Google API，而 JWT 只在瀏覽器有 session
/// 時才拿得到。前端登入時把 refresh token 交給 /internal/calendar-connection 落庫。
///
/// ⚠️ refresh token 目前明文儲存（本機／自架 DB 的開發階段取捨）。上線前應以
/// KMS 或 app 層對稱加密包一層，見 docs/11-優化清單.md。
model CalendarConnection {
  id                   Int              @id @default(autoincrement())
  userId               Int              @unique @map("vexa_user_id")
  refreshToken         String           @map("refresh_token")
  /// 快取的 access token；過期就用 refreshToken 換新的，省下每次呼叫都換一次
  accessToken          String?          @map("access_token")
  accessTokenExpiresAt DateTime?        @map("access_token_expires_at")
  /// Google Calendar 增量同步的 syncToken（有就只抓異動，沒有就整批重抓）
  syncToken            String?          @map("sync_token")
  status               ConnectionStatus @default(ACTIVE)
  lastSyncedAt         DateTime?        @map("last_synced_at")
  lastSyncError        String?          @map("last_sync_error")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@map("calendar_connections")
  @@schema("app")
}

/// 從成員 Google Calendar 匯入的忙碌時段快取。
///
/// 只存「幾點到幾點忙」，不存標題與與會者——疊圖與找空檔只需要這個，
/// 少存一份別人的行程內容也少一份隱私風險（spec §5 隱私）。
model BusyBlock {
  id        String   @id @default(uuid())
  userId    Int      @map("vexa_user_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  /// 這批快取是哪一次同步抓回來的；重抓某區間時用它整批汰換
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([userId, startAt])
  @@map("busy_blocks")
  @@schema("app")
}

// ── Enums ──────────────────────────────────────────

enum IndexingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("indexing_status")
  @@schema("app")
}

enum EditAction {
  UPLOAD
  DELETE

  @@map("edit_action")
  @@schema("app")
}

enum ActivityAction {
  MATERIAL_UPLOAD
  MATERIAL_DELETE
  MEMBER_INVITE
  MEMBER_ADD
  MEMBER_REMOVE
  MEMBER_PERMISSION_UPDATE
  MEETING_CREATE
  MEETING_DELETE
  PROJECT_RENAME

  @@map("activity_action")
  @@schema("app")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("invitation_status")
  @@schema("app")
}

/// SCHEDULED = 已排定但蜜塔還沒進去（行事曆專用，**不佔並發額度**）
/// PENDING   = 蜜塔加入中；ACTIVE = 蜜塔在會議裡（並發上限看這個）
/// CANCELED  = 會議被取消（行事曆上劃掉、不佔忙碌判斷）。與 FAILED 不同：
///             FAILED 是「蜜塔沒進去」，CANCELED 是「這場會不開了」。
enum RsvpStatus {
  ACCEPTED
  TENTATIVE
  DECLINED
  PENDING

  @@map("rsvp_status")
  @@schema("app")
}

enum ConnectionStatus {
  ACTIVE
  /// refresh token 被撤銷或失效 → 前端提示重新連結，期間退回僅本系統資料
  EXPIRED

  @@map("connection_status")
  @@schema("app")
}

enum MeetingStatus {
  SCHEDULED
  PENDING
  ACTIVE
  ENDED
  FAILED
  CANCELED

  @@map("meeting_status")
  @@schema("app")
}
